generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id         String            @id @default(cuid())
  name       String
  rnc        String?
  createdAt  DateTime          @default(now())
  users       User[]
  employees   Employee[]
  devices     Device[]
  contracts   Contract[]
  structures  SalaryStructure[]
  payslipRuns PayslipRun[]
  novelties   Novelty[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("hr")
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
}

model Employee {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id])
  code         String
  name         String
  email        String?
  phone        String?
  department   String?
  jobTitle     String?
  active       Boolean           @default(true)
  biometricPin String?
  createdAt    DateTime          @default(now())
  contracts    Contract[]
  debts        EmployeeDebt[]
  events       AttendanceEvent[]
  hikUsers     HikvisionUser[]
  payslips     Payslip[]
  novelties    Novelty[]

  @@unique([companyId, code])
  @@index([biometricPin])
}

/** Cuaderno de novedades: faltas, licencias, permisos, notas */
model Novelty {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  type           String
  dateFrom       DateTime  @db.Date
  dateTo         DateTime? @db.Date
  days           Decimal   @default(1) @db.Decimal(6, 2)
  reason         String?
  status         String    @default("approved")
  affectsPayroll Boolean   @default(true)
  paid           Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([companyId, dateFrom])
  @@index([employeeId, dateFrom])
}

model Device {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  name           String
  model          String            @default("DS-K1T321EFWX")
  serialNumber   String?
  ipAddress      String?
  port           Int               @default(80)
  useHttps       Boolean           @default(false)
  username       String            @default("admin")
  password       String            @default("")
  connectionType String            @default("push")
  isActive       Boolean           @default(true)
  timezone       String            @default("America/Santo_Domingo")
  lastSync       DateTime?
  lastStatus     String            @default("offline")
  firmware       String?
  macAddress     String?
  createdAt      DateTime          @default(now())
  events         AttendanceEvent[]
  hikUsers       HikvisionUser[]
}

model HikvisionUser {
  id         String    @id @default(cuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeNo String
  name       String
  raw        Json?
  syncedAt   DateTime  @default(now())

  @@unique([deviceId, employeeNo])
}

model AttendanceEvent {
  id                String    @id @default(cuid())
  companyId         String
  deviceId          String?
  device            Device?   @relation(fields: [deviceId], references: [id])
  employeeId        String?
  employee          Employee? @relation(fields: [employeeId], references: [id])
  employeeNo        String
  employeeName      String
  eventAt           DateTime
  receivedAt        DateTime  @default(now())
  major             Int?
  minor             Int?
  verifyMode        String?
  isValidAttendance Boolean   @default(true)
  raw               Json?

  @@index([companyId, eventAt])
  @@index([employeeNo, eventAt])
}

model Contract {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  name        String           @default("Contrato")
  wage        Decimal          @db.Decimal(12, 2)
  structureId String?
  structure   SalaryStructure? @relation(fields: [structureId], references: [id])
  dateStart   DateTime         @db.Date
  dateEnd     DateTime?        @db.Date
  state       String           @default("open")
  createdAt   DateTime         @default(now())
  payslips    Payslip[]
}

model SalaryStructure {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  name      String
  code      String
  rules     SalaryRule[]
  contracts Contract[]
  payslips  Payslip[]

  @@unique([companyId, code])
}

model SalaryRule {
  id          String          @id @default(cuid())
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name        String
  code        String
  sequence    Int             @default(10)
  category    String
  amountType  String          @default("fixed")
  amount      Decimal         @db.Decimal(12, 2)
  active      Boolean         @default(true)

  @@unique([structureId, code])
}

model EmployeeDebt {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  remaining  Decimal  @db.Decimal(12, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model PayslipRun {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  dateStart DateTime  @db.Date
  dateEnd   DateTime  @db.Date
  state     String    @default("draft")
  createdAt DateTime  @default(now())
  payslips  Payslip[]
}

model Payslip {
  id            String           @id @default(cuid())
  runId         String?
  run           PayslipRun?      @relation(fields: [runId], references: [id])
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  contractId    String?
  contract      Contract?        @relation(fields: [contractId], references: [id])
  structureId   String?
  structure     SalaryStructure? @relation(fields: [structureId], references: [id])
  name          String
  dateFrom      DateTime         @db.Date
  dateTo        DateTime         @db.Date
  state         String           @default("draft")
  workedDays    Int              @default(0)
  overtimeHours Decimal          @default(0) @db.Decimal(8, 2)
  basicWage     Decimal          @db.Decimal(12, 2)
  gross         Decimal          @db.Decimal(12, 2)
  deductions    Decimal          @db.Decimal(12, 2)
  net           Decimal          @db.Decimal(12, 2)
  lines         Json
  createdAt     DateTime         @default(now())
}
